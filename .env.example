# Local placeholders only. Do not put secrets in this file.
# Copy to .env if a later integration needs configuration.
# The app runs with every value empty.

# Display name used if a desk unit is attached later.
KITDI_DEVICE_NAME=kitdi-desk

# Optional bridge for a future physical companion. Leave empty.
